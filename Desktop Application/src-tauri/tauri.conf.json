{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "26AS Retrieval Portal",
  "version": "1.0.0",
  "identifier": "com.26as.retrieval.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "26AS Retrieval Portal - Desktop Application",
        "width": 1280,
        "height": 850,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGNEVFOEU0NEM5NEEwQUIKUldTcm9KUk01T2hPcjRpaFRCbnJsV0ExdXhtZG9ENkRjQWpzMmhvRnNJZ3BERVdoaFZFTGE0R2gK",
      "endpoints": [
        "https://github.com/RuepeshDev/26AS-Tool/releases/latest/download/latest.json"
      ]
    }
  }
}
