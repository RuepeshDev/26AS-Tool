{
  "manifest_version": 3,
  "name": "Form 26AS PDF Exporter Companion",
  "key": "",
  "version": "1.0.0",
  "description": "Companion extension to securely download Form 26AS PDFs locally.",
  "permissions": [
    "downloads",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.ngrok-free.dev/*",
      "https://your-deployed-website.com/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; child-src 'self'"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf_renderer.html",
        "renderer_bootstrap.js",
        "traces_globals.js",
        "export_26as_pdf.js",
        "sandbox.html",
        "sandbox_bootstrap.js",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
